<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Sample Food" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".FoodPluginService" android:exported="true">
            <intent-filter>
                <action android:name="com.invocta.action.PLUGIN" />
            </intent-filter>
        </service>
    </application>
</manifest>
