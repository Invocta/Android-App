<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="google_ai_studio_key.xml" />
        <exclude domain="sharedpref" path="openai_api_key.xml" />
        <exclude domain="external" path="Download/models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="google_ai_studio_key.xml" />
        <exclude domain="sharedpref" path="openai_api_key.xml" />
        <exclude domain="external" path="Download/models/" />
    </device-transfer>
</data-extraction-rules>
